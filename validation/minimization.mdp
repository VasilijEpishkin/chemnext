; Диагностическая минимизация одной нейтральной малой молекулы в 10-нм коробке.
; Это НЕ моделирование системы в растворителе и НЕ научный протокол MD.
integrator     = steep
emtol          = 1000.0
emstep         = 0.01
nsteps         = 100
nstlog         = 1
nstenergy      = 1
cutoff-scheme  = Verlet
nstlist        = 10
coulombtype    = Cut-off
rcoulomb       = 1.0
vdwtype        = Cut-off
rvdw           = 1.0
pbc            = xyz
constraints    = none
